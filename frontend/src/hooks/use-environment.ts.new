import { createContext, useContext, ReactNode } from 'react';
import { ApiClient } from '@/lib/api';

interface EnvironmentContextType {
  apiClient: ApiClient;
}

// Determine if in development mode from Vite's environment variable
const isDevelopmentMode = import.meta.env.MODE === 'development';

// Create a single API client instance
const apiClient = new ApiClient(isDevelopmentMode);

const EnvironmentContext = createContext<EnvironmentContextType>({
  apiClient
});

export const EnvironmentProvider: React.FC<{children: ReactNode}> = (props) => {
  return (
    EnvironmentContext.Provider({
      value: { apiClient },
      children: props.children
    })
  );
};

export const useEnvironment = () => {
  return useContext(EnvironmentContext);
};